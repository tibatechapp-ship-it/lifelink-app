# LifeLink — environment template
#
# Copy to `.env` (gitignored) and fill in ONLY what you use. Nothing secret is
# committed; the compose stack refuses to start while the required values below
# are empty.

# ── docker compose secrets (required) ──────────────────────────────────────
# Generate both once:
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 32
SECRET_KEY=
DB_PASSWORD=
# Optional: separate JWT key (falls back to SECRET_KEY).
JWT_SECRET_KEY=
# Field encryption key for names/phones/cities at rest. Empty = values are
# stored as-is (dev only) — set it in production.
FIELD_ENCRYPTION_KEY=

# ── database (compose) ─────────────────────────────────────────────────────
DB_USER=lifelink
DB_NAME=lifelink
# Host port the app publishes (the container always listens on 5000).
APP_PORT=5000
IMAGE_TAG=local

# ── database (host / platform) ─────────────────────────────────────────────
# The app reads ONE variable. Both forms work — `postgres://` (Render, Heroku,
# Railway) and `postgresql://` are rewritten to `postgresql+psycopg://` by
# models/database.py. A SQLite URL is honoured for local dev and tests.
# Empty = sqlite:///<repo>/lifelink.db
DATABASE_URL=
# Legacy SQLite location, used only when DATABASE_URL is empty.
LIFELINK_DB_PATH=

# ── runtime ────────────────────────────────────────────────────────────────
# production makes an empty SECRET_KEY fatal instead of generating one.
FLASK_ENV=production
# 1 = enable the rate limiters, 0 = off (tests set 0).
RATE_LIMIT_ENABLED=1
# gunicorn workers/threads (the container entrypoint reads these).
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=60
# Dev-server bind (only used by `python app.py`).
HOST=127.0.0.1
PORT=5000
TZ=UTC
